<!--
  ANNOTATION TEMPLATE: the label put on every capture image. Edit it to suit your station. You can
  use ANY key of config/settings.yml (station_title, ground_station_location, antenna_information,
  …) and these, passed in for each image:

    * capture_start - start time of the capture
    * enhancement - name of the enhancement (composite)
    * sat_max_elevation - maximum elevation that the satellite reaches
    * sat_name - name of the satellite
    * sun_elevation - elevation of the sun during the capture
    * pass_direction - direction of the satellite pass
    * pass_side_long - whether the pass was east or west of the station ("East" / "West")
    * gain - SDR gain used for the capture

  Write a variable as {{ my_var }}. To add a logo, put a square PNG (e.g. logo.png, 256 px) in
  this folder and replace the first cell's text with:
      <img src="logo.png" width="64" height="64" alt="">
  Keep the panel colour exactly #cacaca and the page white: meteor_normalize_annotate.sh makes that
  colour 70% transparent and rounds the corners after rendering.
-->

<style>html, body { background: #ffffff; margin: 0; padding: 4px; }</style>
<div style="width: 850px; background-color: #cacaca; border: 2px solid #333333; border-radius: 16px; padding: 3px;">
<table style="width: 100%; text-align: center; height: 20px; border-collapse: collapse;">
      <tbody>
        <tr>
          <td style="width: 69.000px;"><center><font color="black"><b>LRPT</b></font></center></td>
          <td style="width: 650.13px;"><center>
          <font color="black">{{ station_title }}<br>
          {{ ground_station_location }}<br>
          137 MHz {{ antenna_information }} antenna</font></center>
          </td>
          <td style="width: 1313.13px;"><font color="black">
          <center>Satellite: {{ sat_name }} | {{ capture_start }}<br>
          Max Elevation: {{ sat_max_elevation }}&#176; {{ pass_side_long }} | Sun Elevation: {{ sun_elevation }}&#176; <br>
          Direction: {{ pass_direction }} | {{ enhancement }} | Gain: {{ gain }}</center>
          </font></td>
        </tr>
      </tbody>
    </table>
</div>
