{
  "type": "object",
  "properties": {
    "latitude":              { "type": "number" },
    "longitude":             { "type": "number" },
    "altitude":              { "type": "number" },
    "ntp_server":            { "type": "string" },
    "test_gain":             { "type": "number" },
    "test_sdr_device_id":    { "type": "number" },
    "test_enable_bias_tee":  { "type": "boolean" },
    "test_freq_offset":      { "type": "number" },
    "receiver_type": {
      "type": "string",
      "enum": [ "rtlsdr", "airspy_mini", "airspy_r2", "airspy_hf_plus_discovery", "hackrf", "sdrplay", "mirisdr" ]
    },
    "select_best_overlapping_passes": { "type": "boolean" },
    "meteor_m2_3_schedule":        { "type": "boolean" },
    "meteor_m2_3_sdr_device_id":   { "type": "number" },
    "meteor_m2_3_freq_offset":     { "type": "number" },
    "meteor_m2_3_enable_bias_tee": { "type": "boolean" },
    "meteor_m2_3_gain":            { "type": "number" },
    "meteor_m2_3_sun_min_elevation": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "meteor_m2_3_schedule_sun_min_elevation": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "meteor_m2_3_sat_min_elevation": {
      "type": "number",
      "minimum": 0,
      "maximum": 90
    },
    "meteor_m2_4_schedule":        { "type": "boolean" },
    "meteor_m2_4_sdr_device_id":   { "type": "number" },
    "meteor_m2_4_freq_offset":     { "type": "number" },
    "meteor_m2_4_enable_bias_tee": { "type": "boolean" },
    "meteor_m2_4_gain":            { "type": "number" },
    "meteor_m2_4_sun_min_elevation": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "meteor_m2_4_schedule_sun_min_elevation": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "meteor_m2_4_sat_min_elevation": {
      "type": "number",
      "minimum": 0,
      "maximum": 90
    },
    "storage":                                       { "type": "string", "enum": ["sd", "ssd"] },
    "use_device_string":                             { "type": "boolean" },
    "meteor_m2_3_80k_interleaving":                  { "type": "boolean" },
    "days_to_schedule_passes":                       { "type": "number" },
    "keep_recordings":                               { "type": "integer", "minimum": 0 },
    "iss_sstv":                                      { "type": "boolean" },
    "iss_sstv_dates":                                { "type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "iss_sstv_min_elevation":                        { "type": "integer", "minimum": 0, "maximum": 90 },
    "iss_sstv_frequency":                            { "type": "number", "minimum": 144.0, "maximum": 438.0 },
    "iss_sstv_gain":                                 { "type": "number", "minimum": 0, "maximum": 50 },
    "iss_aprs":                                      { "type": "boolean" },
    "iss_aprs_frequency":                            { "type": "number", "minimum": 144, "maximum": 440 },
    "daily_map":                                     { "type": "boolean" },
    "map_capitals":                                  { "type": "boolean" },
    "flip_meteor_image":                             { "type": "boolean" },
    "produce_spectrogram":                           { "type": "boolean" },
    "image_annotation_location":                     { "type": "string" },
    "annotation_width_percent":                      { "type": "number", "minimum": 0, "maximum": 100 },
    "annotation_style":                              { "type": "string", "enum": ["light", "dark", "auto", "white", "black", "clear"] },
    "annotation_transparency":                       { "type": "number", "minimum": 0, "maximum": 100 },
    "annotation_background":                         { "type": "string", "pattern": "^(#[0-9a-fA-F]{6})?$" },
    "annotation_text_colour":                        { "type": "string", "pattern": "^(#[0-9a-fA-F]{6})?$" },
    "annotation_border_colour":                      { "type": "string", "pattern": "^(#[0-9a-fA-F]{6})?$" },
    "extend_for_annotation":                         { "type": "boolean" },
    "produce_polar_az_el_graph":                     { "type": "boolean" },
    "produce_polar_direction_graph":                 { "type": "boolean" },
    "ground_station_location":                       { "type": "string" },
    "show_sun_elevation":                            { "type": "boolean" },
    "show_pass_direction":                           { "type": "boolean" },
    "meteor_jpg_image_quality": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "meteor_daytime_enhancements":       { "type": "string" },
    "meteor_nighttime_enhancements":     { "type": "string" },
    "meteor_daytime_thumbnail":          { "type": "string" },
    "meteor_nighttime_thumbnail":        { "type": "string" },
    "meteor_create_equidistant_projection":          { "type": "boolean" },
    "meteor_create_mercator_projection":             { "type": "boolean" },
    "meteor_create_spreaded_images_without_overlay": { "type": "boolean" },
    "meteor_create_rain_probability_overlay":        { "type": "boolean" },
    "meteor_map_crosshair_enable":                   { "type": "boolean" },
    "meteor_map_crosshair_color":                    { "type": "string" },
    "meteor_draw_map_overlay":                       { "type": "boolean" },
    "meteor_draw_cities":                            { "type": "boolean" },
    "meteor_map_country_border_color":               { "type": "string" },
    "lang_setting": {
      "type": "string",
      "enum": [ "ar", "bg", "cn", "de", "en", "es", "fr", "lt", "nl", "pt", "sr", "ru", "it", "hu", "gr", "kr", "ro" ]
    },
    "station_title": { "type": "string" },
    "web_server_name": { "type": "string" },
    "enable_non_tls":  { "type": "boolean" },
    "web_port": {
      "type": "number",
      "minimum": 1,
      "maximum": 65534
    },
    "enable_tls": { "type": "boolean" },
    "web_tls_port": {
      "type": "number",
      "minimum": 1,
      "maximum": 65534
    },
    "lock_admin_page":        { "type": "boolean" },
    "admin_username":         { "type": "string" },
    "admin_password":         { "type": "string" },
    "web_passes_date_format": { "type": "string" },
    "web_datetime_format":    { "type": "string" },
    "log_level": {
      "type": "string",
      "enum": [ "DEBUG", "WARN", "INFO", "ERROR" ]
    },
    "disable_at_mail":         { "type": "boolean" },
    "experimental_features":   { "type": "boolean" },
    "enable_animation":        { "type": "boolean" },
    "animation_area":          { "type": "string", "pattern": "^-?[0-9.]+ -?[0-9.]+ -?[0-9.]+ -?[0-9.]+$" },
    "map_projection":          { "type": "string", "enum": ["equal_earth", "equirectangular"] },
    "delete_oldest_n":         { "type": "number" },
    "delete_older_than_n":     { "type": "number" },
    "disable_wifi_power_mgmt": { "type": "boolean" },
    "discord_webhook":         { "type": "string", "pattern": "^(https://(canary\\.|ptb\\.)?(discord|discordapp)\\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+)?$" },
    "discord_site_url":        { "type": "string", "pattern": "^(https?://[^\\s]+)?$" },
    "discord_images":          { "type": "integer", "minimum": 0, "maximum": 9 },
    "discord_sky_track":       { "type": "boolean" },
    "sdr_extra_options":       { "type": "string", "pattern": "^[A-Za-z0-9_ .=:-]*$" },
    "sdrplay_licence_accepted": { "type": "boolean" }
  },
